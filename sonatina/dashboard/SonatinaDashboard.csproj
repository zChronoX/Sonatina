<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sonatina dashboard: WinUI 3 window over the tray process (talks to it through
       sonatina_ipc: 127.0.0.1 + token in %LOCALAPPDATA%\Sonatina\ipc.json).
       Unpackaged and self-contained: nothing to install besides Sonatina.
       Build:  dotnet publish -c Release -o publish   (or build.ps1) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SonatinaDashboard</RootNamespace>
    <AssemblyName>SonatinaDashboard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\installer\sonatina.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\installer\sonatina.ico" Link="sonatina.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
