<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SonatinaDashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:SonatinaDashboard">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- title bar (the caption buttons are drawn by Windows on the right) -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xEC4F;" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <TextBlock Grid.Column="1" Text="Sonatina" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="232"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="home" Content="{l:Tr It='Home', En='Home'}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="headsets" Content="{l:Tr It='Cuffie', En='Headphones'}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F6;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="quality" Content="{l:Tr It='Qualità audio', En='Audio quality'}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="mic" Content="{l:Tr It='Microfono', En='Microphone'}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE720;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="diagnostics" Content="{l:Tr It='Diagnostica', En='Diagnostics'}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="about" Content="{l:Tr It='Informazioni', En='About'}">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="OfflineBar" Margin="24,12,24,0" Severity="Warning" IsClosable="False"
                         Title="{l:Tr It='Sonatina non è in esecuzione', En='Sonatina is not running'}"
                         Message="{l:Tr It='La finestra si collega da sola appena Sonatina parte.', En='This window connects by itself as soon as Sonatina starts.'}">
                    <InfoBar.ActionButton>
                        <Button x:Name="StartButton" Click="Start_Click" Content="{l:Tr It='Avvia Sonatina', En='Start Sonatina'}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="MessageBar" Grid.Row="1" Margin="24,12,24,0" IsClosable="True" />
                <Frame x:Name="ContentFrame" Grid.Row="2" Navigated="ContentFrame_Navigated" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
