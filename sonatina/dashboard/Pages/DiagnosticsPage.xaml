<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SonatinaDashboard.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:SonatinaDashboard"
    NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24,8,24,32">
            <StackPanel Spacing="4" Padding="0,8,0,4">
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr It='Diagnostica', En='Diagnostics'}" />
                <TextBlock x:Name="SubTitle" Style="{StaticResource Secondary}" />
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr It='Collegamento', En='Link'}" />
                    <Grid x:Name="Metrics" ColumnSpacing="16" RowSpacing="16" />
                    <TextBlock x:Name="CallStats" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" FontFamily="Cascadia Mono, Consolas" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="Restart_Click" Content="{l:Tr It='Riavvia connessione', En='Restart connection'}" />
                        <Button Click="OpenLog_Click" Content="{l:Tr It='Apri log', En='Open log'}" />
                        <Button Click="Folder_Click" Content="{l:Tr It='Apri cartella dati', En='Open data folder'}" />
                        <Button Click="Copy_Click" Content="{l:Tr It='Copia stato', En='Copy status'}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Header="{l:Tr It='Stato completo (JSON)', En='Full status (JSON)'}">
                <TextBlock x:Name="Raw" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
