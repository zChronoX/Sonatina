<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SonatinaDashboard.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:SonatinaDashboard"
    NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24,8,24,32">
            <StackPanel Spacing="4" Padding="0,8,0,4">
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr It='Informazioni', En='About'}" />
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="14" VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xEC4F;" FontSize="28" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Sonatina" />
                        <TextBlock x:Name="Versions" Style="{StaticResource Secondary}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{l:Tr It='Musica in LDAC, aptX HD, aptX, AAC e SBC e microfono delle cuffie su Windows, con uno stack Bluetooth tutto suo che gira su una chiavetta USB dedicata.', En='LDAC, aptX HD, aptX, AAC and SBC music and the headset microphone on Windows, with its own Bluetooth stack running on a dedicated USB adapter.'}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12" MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr It='Avvia con Windows', En='Start with Windows'}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr It='Sonatina parte all’accesso, nell’area di notifica', En='Sonatina starts at sign-in, in the notification area'}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="Autostart" Grid.Column="1" Toggled="Autostart_Toggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" />
                    <Grid ColumnSpacing="12" MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr It='File di log', En='Log file'}" />
                            <TextBlock x:Name="LogPath" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OpenLog_Click" Content="{l:Tr It='Apri', En='Open'}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr It='Componenti open source', En='Open source components'}" />
                    <TextBlock Style="{StaticResource Secondary}" IsTextSelectionEnabled="True" Text="Bumble (Google) · Apache 2.0&#x0a;libusb · LGPL 2.1&#x0a;libldac (AOSP) · Apache 2.0&#x0a;Fraunhofer FDK AAC · FDK license&#x0a;libfreeaptx · LGPL 2.1&#x0a;libsbc (AOSP) · Apache 2.0&#x0a;Windows App SDK / WinUI 3 · MIT" />
                    <TextBlock Style="{StaticResource Hint}" Text="{l:Tr It='Il microfono virtuale usa Hi-Fi Cable e la musica VB-CABLE, di VB-Audio (donationware).', En='The virtual microphone uses Hi-Fi Cable and music uses VB-CABLE, by VB-Audio (donationware).'}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
