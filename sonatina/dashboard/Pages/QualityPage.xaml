<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SonatinaDashboard.Pages.QualityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:SonatinaDashboard"
    NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24,8,24,32">
            <Grid Padding="0,8,0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr It='Qualità audio', En='Audio quality'}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{l:Tr It='Codec ed equalizzatore sono ricordati per ogni cuffia. Se un codec non va, Sonatina passa al successivo.', En='Codec and equalizer are remembered for each pair of headphones. If a codec does not work, Sonatina moves to the next one.'}" />
                </StackPanel>
                <ComboBox x:Name="HeadsetBox" Grid.Column="1" MinWidth="220" VerticalAlignment="Top"
                          Header="{l:Tr It='Cuffie', En='Headphones'}" SelectionChanged="HeadsetBox_SelectionChanged" />
            </Grid>

            <!-- now -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="24" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr It='In uso adesso', En='In use now'}" />
                        <TextBlock x:Name="NowCodec" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr It='Bitrate', En='Bitrate'}" />
                        <TextBlock x:Name="NowRate" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr It='Ritardo stimato', En='Estimated delay'}" />
                        <TextBlock x:Name="NowDelay" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- codec -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr It='Codec preferito', En='Preferred codec'}" />
                    <StackPanel x:Name="CodecList" Spacing="2" />
                    <Grid x:Name="LdacRow" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr It='Qualità LDAC', En='LDAC quality'}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr It='Più alta = più dettagli, ma serve un segnale migliore (cuffie vicine alla chiavetta)', En='Higher = more detail, but needs a better signal (headphones close to the adapter)'}" />
                        </StackPanel>
                        <ComboBox x:Name="LdacBox" Grid.Column="1" MinWidth="220" SelectionChanged="LdacBox_SelectionChanged" />
                    </Grid>
                    <Grid x:Name="AdaptiveRow" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr It='Qualità adattiva', En='Adaptive quality'}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr It='Se la radio non regge (cuffie lontane, Wi-Fi a 2,4 GHz vicino) scende di un gradino e poi risale da sola, mai sopra la qualità scelta. LDAC 990 → 660 → 330, SBC e AAC con meno kbit/s.', En='When the radio cannot keep up (headphones far away, 2.4 GHz Wi-Fi nearby) it steps down and comes back by itself, never above the chosen quality. LDAC 990 → 660 → 330, SBC and AAC with fewer kbit/s.'}" />
                            <TextBlock x:Name="AdaptiveNow" Style="{StaticResource Hint}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="Adaptive" Grid.Column="1" Toggled="Adaptive_Toggled" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr It='Cambio codec senza scollegare', En='Change codec without disconnecting'}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr It='La musica si ferma meno di un secondo e le cuffie restano collegate. Spento: si ricollegano (qualche secondo).', En='Music stops for less than a second and the headphones stay connected. Off: they reconnect (a few seconds).'}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="LiveSwitch" Grid.Column="1" Tag="codec_switch_live" Toggled="Option_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- low latency (M3) -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr It='Bassa latenza', En='Low latency'}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{l:Tr It='Buffer più piccoli: il suono arriva prima (giochi, video), ma con più rischio di interruzioni. Cambia al volo, senza ricollegare le cuffie.', En='Smaller buffers: sound arrives sooner (games, video), with more risk of dropouts. Changes on the fly, without reconnecting the headphones.'}" />
                    <l:Segmented x:Name="LatencyMode" />
                    <StackPanel x:Name="AppsPanel" Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="{l:Tr It='Attiva quando è aperta una di queste app', En='On while one of these apps is open'}" />
                        <l:WrapPanel x:Name="AppChips" Spacing="8" />
                        <TextBlock x:Name="NoApps" Style="{StaticResource Hint}" Text="{l:Tr It='Nessuna app scelta: aggiungine una qui sotto.', En='No app chosen: add one below.'}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr It='Aggiungi un’app aperta adesso (quelle che hanno l’audio aperto):', En='Add an app open now (the ones with audio open):'}" />
                        <l:WrapPanel x:Name="RunningApps" Spacing="8" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource Divider}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="LatencyDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="LatencyNow" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- equalizer (M4) -->
            <Border x:Name="EqCard" Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr It='Equalizzatore', En='Equalizer'}" />
                            <TextBlock x:Name="EqFor" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="EqSwitch" Grid.Column="1" Toggled="EqSwitch_Toggled" />
                    </Grid>
                    <l:Segmented x:Name="EqPresets" />
                    <Grid x:Name="EqBands" ColumnSpacing="8" />
                    <TextBlock x:Name="EqHint" Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
